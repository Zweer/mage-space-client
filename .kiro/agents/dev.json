{
  "name": "dev",
  "description": "Development agent — implements the mage-space-client TypeScript library from API docs",
  "prompt": "file://../prompts/dev.md",
  "resources": ["file://docs/api/**/*.md", "file://AGENTS.md", "file://.kiro/steering/**/*.md"],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "code"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          ".kiro/**",
          "lib/**",
          "test/**",
          "docs/**",
          "package.json",
          "package-lock.json",
          "tsconfig.json",
          "biome.json",
          "vitest.config.ts",
          "tsdown.config.ts",
          "README.md",
          "AGENTS.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": ["*git commit*", "*git push*", "*git tag *", "*npm publish*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      }
    ]
  }
}
