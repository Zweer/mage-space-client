{
  "name": "rev-eng",
  "description": "Reverse engineering agent — discovers mage.space's internal API via Playwright browser automation",
  "prompt": "file://../prompts/rev-eng.md",
  "resources": ["file://docs/api/**/*.md", "file://AGENTS.md", "file://.env.example"],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "@playwright"
  ],
  "allowedTools": ["read", "grep", "glob", "@playwright"],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["docs/api/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [".*git commit.*", ".*git push.*", ".*git tag .*", ".*npm publish.*"]
    }
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--caps=core,network,storage",
        "--console-level=info"
      ]
    }
  }
}
