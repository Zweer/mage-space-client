{
  "name": "rev-eng",
  "description": "Reverse engineering agent — discovers mage.space's internal API via Playwright browser automation",
  "prompt": "file://../prompts/rev-eng.md",
  "resources": ["file://docs/api/**/*.md", "file://AGENTS.md", "file://.env.example"],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "@playwright"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": ["docs/api/**"],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": ["*git commit*", "*git push*", "*git tag *", "*npm publish*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--caps=core,network,storage",
        "--console-level=info"
      ]
    }
  }
}
