{
  "name": "@zweer/mage-space-client",
  "version": "1.5.0",
  "description": "A TypeScript client for mage.space's internal API. Generate images programmatically.",
  "keywords": [
    "mage",
    "mage.space",
    "ai",
    "image-generation",
    "client"
  ],
  "homepage": "https://github.com/Zweer/mage-space-client#readme",
  "bugs": {
    "url": "https://github.com/Zweer/mage-space-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zweer/mage-space-client.git"
  },
  "license": "MIT",
  "author": "Zweer <n.olivieriachille@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "concurrently npm:lint:* --prefixColors auto",
    "lint:engines": "installed-check --engine-check --ignore-dev",
    "lint:format": "biome check --write",
    "lint:lockfile": "lockfile-lint",
    "lint:package": "npmPkgJsonLint .",
    "lint:sort_package": "sort-package-json \"package.json\"",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "test -n \"$CI\" || lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "installed-check": "^11.0.0",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.1.0",
    "msw": "^3.0.7",
    "npm-package-json-lint": "^11.0.1",
    "npm-package-json-lint-config-default": "^10.0.0",
    "rimraf": "^6.1.4",
    "sort-package-json": "^4.1.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
