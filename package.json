{
  "name": "@zweer/mage-space-client",
  "version": "1.0.0",
  "description": "A TypeScript client for mage.space's internal API. Generate images programmatically.",
  "keywords": [
    "mage",
    "mage.space",
    "ai",
    "image-generation",
    "client"
  ],
  "homepage": "https://github.com/Zweer/mage-space-client#readme",
  "bugs": {
    "url": "https://github.com/Zweer/mage-space-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zweer/mage-space-client.git"
  },
  "license": "MIT",
  "author": "Zweer <n.olivieriachille@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "lint": "concurrently npm:lint:* --prefixColors auto",
    "lint:engines": "ls-engines",
    "lint:format": "biome check --write",
    "lint:lockfile": "lockfile-lint",
    "lint:package": "npmPkgJsonLint .",
    "lint:sort_package": "sort-package-json \"package.json\"",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "test -n \"$CI\" || lefthook install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "lefthook": "^2.1.9",
    "lockfile-lint": "^5.0.0",
    "ls-engines": "^0.10.1",
    "msw": "^2.14.6",
    "npm-package-json-lint": "^10.4.1",
    "npm-package-json-lint-config-default": "^9.0.1",
    "rimraf": "^6.1.3",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
